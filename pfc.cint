
uint32 flags;
int port;
int tc;
bcm_gport_t pgport;

int max_port = 351;
int uc_num[max_port] = {0};
int mc_num[max_port] = {0};
bcm_gport_t uc_queue[max_port][12];
bcm_gport_t mc_queue[max_port][12];
bcm_gport_t ucgport, mcgport;


bcm_port_config_t port_config;
bcm_pbmp_t pbmp;

print bcm_port_config_get(0, &port_config);
pbmp = port_config.e;

int gport_callback(int unit, bcm_gport_t port, int numq, uint32 flags, bcm_gport_t gport, void *user_data)
{
    int local_port;
    int rv;

    local_port = BCM_GPORT_MODPORT_PORT_GET(port);
    if (local_port != 0)
    {
        if (flags & BCM_COSQ_GPORT_SCHEDULER)
        {
        }
        else if (flags & BCM_COSQ_GPORT_UCAST_QUEUE_GROUP)
        {
            uc_queue[local_port][uc_num[local_port]++] = gport;
        }
        else if (flags & BCM_COSQ_GPORT_MCAST_QUEUE_GROUP)
        {
            mc_queue[local_port][mc_num[local_port]++] = gport;
        }
    }
    return 0;
}

bcm_cosq_gport_traverse(0, gport_callback, (void*)0);

int qmapid;
int dscp;
bcm_qos_map_t qosmap;

flags = BCM_QOS_MAP_INGRESS | BCM_QOS_MAP_L3;
print bcm_qos_map_create(0, flags, &qmapid);

bcm_qos_map_t_init(&qosmap);

for (dscp=0; dscp < 64; dscp++)
{
    qosmap.dscp=dscp;
    qosmap.int_pri=0;
    
    if (dscp == 26)
    {
        qosmap.int_pri= 3;
    }
    else if (dscp == 48)
    {
        qosmap.int_pri= 6;
    }
    print bcm_qos_map_add(0, flags, &qosmap, qmapid);
}

BCM_PBMP_ITER(pbmp, port)
{
    bcm_port_control_set(0, port, bcmPortControlMmuTrafficEnable, 0);
    
    print bcm_port_gport_get(0, port, &pgport);
    print bcm_qos_port_map_set(0, pgport, qmapid, -1);
}

BCM_PBMP_ITER(pbmp, port)
{
    flags = BCM_COSQ_GPORT_UCAST_QUEUE_GROUP;
    for (tc = 0; tc < 8; tc++)
    {
        print bcm_cosq_gport_mapping_set(0, port, tc, flags, uc_queue[port][tc], 0);
    }

    flags = BCM_COSQ_GPORT_MCAST_QUEUE_GROUP;
    for (tc = 0; tc < 8; tc++)
    {
        bcm_gport_t _gport;
        if (tc >= 4)
        {
            _gport = mc_queue[port][3];
        }
        else
        {
            _gport = mc_queue[port][tc];
        }
        print bcm_cosq_gport_mapping_set(0, port, tc, flags, _gport, 0);
    }

    profile_idx = 1;
    print bcm_cosq_port_profile_set(0, port, bcmCosqProfileIntPriToPGMap, profile_idx);
    pg_arr[0] = 0;
    pg_arr[1] = 1;
    pg_arr[2] = 2;
    pg_arr[3] = 3;
    pg_arr[4] = 4;
    pg_arr[5] = 5;
    pg_arr[6] = 6;
    pg_arr[7] = 7;
    print bcm_cosq_priority_group_mapping_profile_set(0, profile_idx, bcmCosqInputPriPriorityGroupUcMapping, 16, pg_arr);
    print bcm_cosq_priority_group_mapping_profile_set(0, profile_idx, bcmCosqInputPriPriorityGroupMcMapping, 16, pg_arr);
}

