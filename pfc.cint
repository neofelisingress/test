    print bcm_cosq_port_priority_group_property_set(0, port, 2, bcmCosqPriorityGroupLossless, 0);
    print bcm_cosq_port_priority_group_property_set(0, port, 3, bcmCosqPriorityGroupLossless, 1);
    print bcm_cosq_port_priority_group_property_set(0, port, 4, bcmCosqPriorityGroupLossless, 0);
    print bcm_cosq_port_priority_group_property_set(0, port, 5, bcmCosqPriorityGroupLossless, 0);
    print bcm_cosq_port_priority_group_property_set(0, port, 6, bcmCosqPriorityGroupLossless, 0);
    print bcm_cosq_port_priority_group_property_set(0, port, 7, bcmCosqPriorityGroupLossless, 0);

    bcm_cosq_pfc_class_map_config_t config_array[8];
