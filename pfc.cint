    prigrp_config.pfc_transmit_enable = 0;
    bcm_port_priority_group_config_set(0, port, 5, &prigrp_config);
    prigrp_config.pfc_transmit_enable = 0;
    bcm_port_priority_group_config_set(0, port, 6, &prigrp_config);
    prigrp_config.pfc_transmit_enable = 0;
    print bcm_port_priority_group_config_set(0, port, 7, &prigrp_config);
    print bcm_cosq_port_priority_group_property_set(0, port, 0, bcmCosqPriorityGroupLossless, 0);
