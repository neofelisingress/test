BCM_PBMP_ITER(pbmp, port)
{
    bcm_port_priority_group_config_t prigrp_config;
    sal_memset(&prigrp_config, 0, sizeof(prigrp_config));
    
    print bcm_port_control_set(0, port, bcmPortControlPFCTransmit, 8);

    prigrp_config.pfc_transmit_enable = 0;
    bcm_port_priority_group_config_set(0, port, 0, &prigrp_config);
    prigrp_config.pfc_transmit_enable = 0;
    bcm_port_priority_group_config_set(0, port, 1, &prigrp_config);
    prigrp_config.pfc_transmit_enable = 0;
