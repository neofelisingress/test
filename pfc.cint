    config_array[0].pfc_flags = BCM_COSQ_PFC_MAP_TO_QUEUES;
    bcm_cosq_pfc_class_map_config_t_init(&config_array[1]);
    config_array[1].pfc_flags = BCM_COSQ_PFC_MAP_TO_QUEUES;
    bcm_cosq_pfc_class_map_config_t_init(&config_array[2]);
    config_array[2].pfc_flags = BCM_COSQ_PFC_MAP_TO_QUEUES;
